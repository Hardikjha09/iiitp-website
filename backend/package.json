{
  "name": "iiitp-backend",
  "version": "1.0.0",
  "description": "Express API backend for the IIIT Pune CMS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "http-graceful-shutdown": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "mariadb": "^3.5.3",
    "multer": "^2.2.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.6",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.15.0",
    "prisma": "^7.9.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/client@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "@prisma/adapter-mariadb@7.9.1": true,
    "mariadb": true,
    "esbuild": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
