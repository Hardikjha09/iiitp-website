{
  "name": "iiitp-backend",
  "version": "1.0.0",
  "description": "Express API backend for the IIIT Pune CMS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --project tsconfig.json prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.6",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "http-graceful-shutdown": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "multer": "^2.2.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.6",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.30",
    "@types/sanitize-html": "^2.15.0",
    "prisma": "^6.12.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
